# 复制为 .env 后按需修改：cp .env.example .env
# 该文件只用于 Docker Compose 变量替换，不会被打包进镜像。

# 宿主机访问端口（容器内固定监听 5000）
ALIPAY_PORT=5000

# 时区，影响日志与订单时间
TZ=Asia/Shanghai

# 支付监控线程：1 开启 / 0 关闭
ALIPAY_MONITOR=1

# 调试模式：生产环境保持 0
ALIPAY_DEBUG=0

# 会话密钥：留空自动生成并保存到 data/.flask_secret
ALIPAY_SECRET_KEY=

# 敏感字段加密密钥：留空自动生成并保存到 data/.secret_key
# 迁移服务器时保持该值一致（或同时迁移 data/.secret_key）
ALIPAY_ENCRYPT_KEY=
